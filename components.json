{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "neutral",
    "cssVariables": true
  },
  "aliases": {
    "components": "@/components",
    "ui": "@/components/ui",
    "utils": "@/lib/utils",
    "lib": "@/lib",
    "hooks": "@/hooks",
    "app": "@/pages",
    "types": "@/types",
    "content": "@/content"
  },
  "registries": {
    "@tailark": {
      "url": "https://tailark.com/r/radix/{name}.json",
      "headers": { "x-api-key": "${TAILARK_API_KEY}" }
    },
    "@tailark-oss": "https://oss.tailark.com/r/radix/{name}.json"
  }
}
