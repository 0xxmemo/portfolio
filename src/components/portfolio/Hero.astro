---
import { Image } from "astro:assets";
import portrait from "../../assets/portrait.jpeg";
import { experiences, profile } from "../../data/portfolio";
import Logo from "./Logo.astro";
---

<section id="home" class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Engineer. Architect. Builder.</p>
    <h1 id="hero-title">Complex systems.<br />Simple execution.<br /><span class="serif-accent">Real impact.</span></h1>
    <p class="hero-intro">I’m {profile.name} — <span class="alias">0xMemo</span> on the internet.<br />I build decentralized systems, modular software, developer tools, and infrastructure that makes the complex feel simple.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#projects">Explore my work <span aria-hidden="true">↗</span></a>
      <a class="button button-text" href={profile.bookingUrl} target="_blank" rel="noopener noreferrer">Book a call <span aria-hidden="true">↗</span></a>
    </div>
    <div class="current-role">
      <span class="role-mark" aria-hidden="true">↳</span>
      <div><span class="micro-label">Currently building</span><a href="https://www.openllm.sh" target="_blank" rel="noopener noreferrer">OpenLLM <span>· CTO & Co-Founder</span> <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>
  <figure class="hero-portrait">
    <div class="portrait-frame">
      <Image src={portrait} alt={`${profile.name} outdoors in the mountains`} widths={[480, 720, 960]} sizes="(max-width: 700px) 90vw, 42vw" width={960} height={1120} fit="cover" position="center" format="webp" loading="eager" fetchpriority="high" class="portrait-image" />
      <span class="portrait-corner" aria-hidden="true">✳</span>
      <div class="portrait-note"><span class="micro-label">A little perspective</span><span>Good ideas need room to breathe.</span></div>
    </div>
    <figcaption><span>Based in Cusco, Peru</span><span>Building beyond borders <span aria-hidden="true">↗</span></span></figcaption>
  </figure>
</section>
<div class="container career-strip">
  <p class="micro-label">A few places I’ve built</p>
  <div class="career-companies">
    {experiences.map((experience) => <span>{experience.logo && <Logo src={experience.logo} size="small" loading="eager" />}{experience.company}</span>)}
  </div>
</div>
