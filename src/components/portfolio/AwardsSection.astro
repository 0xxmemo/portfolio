---
import { awards } from "../../data/portfolio";
import Logo from "./Logo.astro";
---

<section id="awards" class="section container awards-section" aria-labelledby="awards-title">
  <div class="section-heading"><div><p class="eyebrow">05 / Recognition</p><h2 id="awards-title">A few milestones.</h2></div><p>Ideas tested in the real world.</p></div>
  <div class="awards-list">{awards.map((award) => {
    const Tag = award.url ? "a" : "div";
    return <Tag class="award-row" href={award.url} target={award.url ? "_blank" : undefined} rel={award.url ? "noopener noreferrer" : undefined}><Logo src={award.logo} /><div><h3>{award.title}</h3><p>{award.subtitle}</p></div>{award.url && <span class="award-arrow" aria-hidden="true">↗</span>}</Tag>;
  })}</div>
</section>
