---
import { socialLinks, profile } from "../../data/portfolio";
import { socialIconSvg } from "../../data/social-icons";
---

<footer id="links" class="site-footer container">
  <div class="footer-top"><a class="wordmark" href="#home">0xMemo<span aria-hidden="true">.</span></a><nav class="social-links" aria-label="Find me online">{socialLinks.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer"><span aria-hidden="true" set:html={socialIconSvg[link.icon]} /><span>{link.name}</span></a>)}</nav></div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.name}</span><span>Thoughtful systems. A human touch.</span><a href="#home">Back to top <span aria-hidden="true">↑</span></a></div>
</footer>
