---
import { iconMapPin } from "../../data/social-icons";
import { EXPERIENCE_START, getExperienceDuration } from "../../lib/experience-time";

const duration = getExperienceDuration();
const units = ["years", "days", "hours", "minutes", "seconds"] as const;
---

<section id="about" class="about-section" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-heading">
      <p class="eyebrow">02 / A little about me</p>
      <h2 id="about-title">Systems thinker.<br /><span class="serif-accent">Curious human.</span></h2>
      <p class="location"><span aria-hidden="true" set:html={iconMapPin} /> Cusco, Peru · Turkish origin</p>
      <div class="experience-counter" data-experience-counter role="timer" aria-live="off" aria-label="Software engineering experience since January 1, 2019, UTC">
        <p class="counter-caption">Building since <time datetime={EXPERIENCE_START}>01 Jan 2019</time><span>UTC · Still counting</span></p>
        <dl class="counter-units">
          {units.map((unit) => <div><dt>{unit}</dt><dd data-experience-unit={unit}>{String(duration[unit]).padStart(unit === "years" || unit === "days" ? 1 : 2, "0")}</dd></div>)}
        </dl>
      </div>
    </div>
    <div class="about-copy">
      <p class="large-copy">I’m a senior software engineer and architect, turning complicated problems into useful, dependable software. And counting.</p>
      <p>Today, I’m CTO & Co-Founder of <a href="https://www.openllm.sh" target="_blank" rel="noopener noreferrer">OpenLLM</a>, a format-agnostic LLM hub. Bring your own provider keys, route across models, and understand what’s happening with unified observability and cost tracking.</p>
      <p>I build modular systems — decentralized architectures, trustless by default, with decentralization carried into web2 rather than left at the chain boundary. I care about efficiency and quality, earned through incremental improvements instead of rewrites.</p>
      <div class="principles"><span>Modular by design</span><span>Trustless by default</span><span>Better, one iteration at a time</span></div>
    </div>
  </div>
</section>
