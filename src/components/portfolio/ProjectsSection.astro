---
import { projects, projectCategories } from "../../data/portfolio";
import Logo from "./Logo.astro";
---

<section id="projects" class="section container" aria-labelledby="projects-title">
  <div class="section-heading">
    <div><p class="eyebrow">01 / Selected work</p><h2 id="projects-title">Built with intent.</h2></div>
    <p>From the infrastructure underneath<br class="desktop-break" /> to the experience on top.</p>
  </div>
  <div class="project-filters" role="group" aria-label="Filter projects" hidden>
    <button type="button" data-project-filter="featured" aria-pressed="true">Featured <span>{String(projects.filter((project) => project.category === "featured").length).padStart(2, "0")}</span></button>
    {projectCategories.filter((category) => category.id !== "featured").map((category) => <button type="button" data-project-filter={category.id} aria-pressed="false">{category.label} <span>{String(projects.filter((project) => project.category === category.id).length).padStart(2, "0")}</span></button>)}
    <button type="button" data-project-filter="all" aria-pressed="false">All work <span>{projects.length}</span></button>
  </div>
  <div class="projects-grid">
    {projects.map((project) => {
      const categoryIndex = projects.filter((item) => item.category === project.category).indexOf(project) + 1;
      const Tag = project.linkDisabled ? "div" : "a";
      return (
        <article class:list={["project-card", { "project-flagship": project.title === "OpenLLM" }]} data-project-category={project.category} data-project-card={categoryIndex}>
          <div class:list={["project-visual", `visual-${project.category}`, { "visual-openllm": project.title === "OpenLLM", "visual-controlroom": project.title === "Controlroom", "visual-breadcrumb": project.title === "Breadcrumb.cash", "visual-levr": project.title === "Levr" }]} aria-hidden="true">
            <span class="visual-label">{project.category === "featured" ? "Product engineering" : project.category === "sdk" ? "Developer infrastructure" : "Open source"}</span>
            <div class="project-symbol">{project.logo ? <Logo src={project.logo} size="large" /> : <span>{project.title.slice(0, 2)}</span>}</div>
            <span class="visual-wordmark">{project.title}</span>
            <span class="visual-index">/{String(categoryIndex).padStart(2, "0")}</span>
          </div>
          <div class="project-body">
            <p class="micro-label">{project.tags.slice(0, 2).join(" / ")}</p>
            <h3><Tag href={project.linkDisabled ? undefined : project.url} target={project.linkDisabled ? undefined : "_blank"} rel={project.linkDisabled ? undefined : "noopener noreferrer"} class="project-title-link">{project.title}{!project.linkDisabled && <span aria-hidden="true">↗</span>}</Tag></h3>
            <p class="project-description">{project.description}</p>
            <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
            {project.linkDisabled && <p class="micro-label">Link unavailable</p>}
          </div>
        </article>
      );
    })}
  </div>
  <div class="section-footnote"><span>No black boxes. Just thoughtful engineering.</span><a href="https://github.com/0xxmemo" target="_blank" rel="noopener noreferrer">More on GitHub <span aria-hidden="true">↗</span></a></div>
  <p class="sr-only" data-filter-status aria-live="polite"></p>
</section>
