---
import { profile } from "../../data/portfolio";
---

<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="container contact-inner">
    <p class="eyebrow">06 / What’s next?</p>
    <div class="contact-top"><h2 id="contact-title">Something worth building?<br /><span class="serif-accent">Let’s talk.</span></h2><span class="contact-flower" aria-hidden="true">✳</span></div>
    <div class="contact-bottom"><div><p>Collaborations, consulting, or a good conversation<br class="desktop-break" /> about where software goes next.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></div><a class="button button-light" href={profile.bookingUrl} target="_blank" rel="noopener noreferrer">Book a conversation <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
