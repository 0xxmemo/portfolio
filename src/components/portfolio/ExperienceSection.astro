---
import { experiences } from "../../data/portfolio";
import Logo from "./Logo.astro";
---

<section id="experience" class="section container" aria-labelledby="experience-title">
  <div class="section-heading"><div><p class="eyebrow">03 / The journey</p><h2 id="experience-title">Built on experience.</h2></div><p>From first engineer to co-founder.<br class="desktop-break" /> Always close to the code.</p></div>
  <div class="experience-list">
    {experiences.map((experience, index) => <article class="experience-row" data-experience-card={index + 1}>
      <div class="experience-company">{experience.logo && <Logo src={experience.logo} />}<div>{experience.url ? <a href={experience.url} target="_blank" rel="noopener noreferrer">{experience.company} <span aria-hidden="true">↗</span></a> : <span>{experience.company}</span>}<p class="micro-label">{experience.period}</p></div></div>
      <div class="experience-detail"><h3>{experience.title}{index === 0 && <span class="current-badge">Current</span>}</h3><p>{experience.description}</p><div class="tags">{experience.tags.map((tag) => <span>{tag}</span>)}</div></div>
    </article>)}
  </div>
</section>
