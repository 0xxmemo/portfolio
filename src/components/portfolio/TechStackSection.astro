---
import { techRow1, techRow2 } from "../../data/portfolio";
const groups = [
  { title: "Interfaces & languages", symbol: "⌘", items: techRow1.filter((item) => ["TypeScript", "Python", "React", "Next.js", "Astro", "Tailwind CSS"].includes(item)) },
  { title: "Infrastructure & data", symbol: "↳", items: [...techRow1, ...techRow2].filter((item) => ["Node.js", "PostgreSQL", "Vector DBs", "GraphQL", "tRPC", "Prisma", "Docker", "AWS", "Vercel"].includes(item)) },
  { title: "Decentralized systems", symbol: "◇", items: [...techRow1, ...techRow2].filter((item) => ["Solidity", "Viem", "Wagmi", "Ethers.js", "Hardhat", "Foundry", "The Graph", "IPFS"].includes(item)) },
];
---

<section id="tech" class="section container tech-section" aria-labelledby="tech-title">
  <div class="section-heading"><div><p class="eyebrow">04 / The toolkit</p><h2 id="tech-title">The right tools.<br /><span class="serif-accent">Not just the new ones.</span></h2></div><p>A practical stack for shipping<br class="desktop-break" /> across the whole system.</p></div>
  <div class="toolkit-grid">{groups.map((group) => <div class="toolkit-group"><span class="toolkit-symbol" aria-hidden="true">{group.symbol}</span><h3>{group.title}</h3><div class="tags">{group.items.map((item) => <span>{item}</span>)}</div></div>)}</div>
</section>
