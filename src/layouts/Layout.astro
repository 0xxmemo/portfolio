---
import '../index.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.jpeg';
import { profile } from '../data/portfolio';

const socialPortrait = await getImage({ src: portrait, width: 1200, format: 'jpeg' });
const portraitUrl = new URL(socialPortrait.src, 'https://0xmemo.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.alias,
  email: profile.email,
  url: 'https://0xmemo.com',
  image: portraitUrl,
  jobTitle: 'CTO & Co-Founder',
  worksFor: {
    '@type': 'Organization',
    name: 'OpenLLM',
    url: 'https://www.openllm.sh',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Koc University',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cusco',
    addressCountry: 'PE',
  },
  sameAs: [
    'https://x.com/0xxmemo',
    'https://github.com/mguleryuz',
    'https://www.linkedin.com/in/mehmet-guleryuz-9a7381206/',
    'https://medium.com/@0xxmemo',
    'https://t.me/x0memo',
    'https://zora.co/@0xmemo',
  ],
  knowsAbout: [
    'Blockchain Development',
    'Web3',
    'Ethereum',
    'Solidity',
    'TypeScript',
    'React',
    'Next.js',
    'Software Architecture',
    'Full-Stack Development',
  ],
  description:
    'CTO & Co-Founder at OpenLLM. Building decentralized systems, SDKs, and developer tools across Ethereum, Base, and beyond.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try {
        const preference = localStorage.getItem('portfolio-theme');
        if (preference === 'light' || preference === 'dark') document.documentElement.dataset.theme = preference;
      } catch {
        // CSS follows the system theme when storage is unavailable.
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>0xMemo — Software Architect & Blockchain Builder</title>
    <meta name="title" content="0xMemo — Software Architect & Blockchain Builder" />
    <meta
      name="description"
      content="CTO & Co-Founder at OpenLLM. Building decentralized systems, SDKs, and developer tools across Ethereum, Base, and beyond."
    />
    <meta name="author" content={profile.name} />
    <meta
      name="keywords"
      content="blockchain developer, web3, ethereum, solidity, typescript, react, software architect, fullstack developer, openllm, inverter network, breadcrumb, 0xmemo"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://0xmemo.com/" />
    <meta property="og:title" content="0xMemo — Software Architect & Blockchain Builder" />
    <meta
      property="og:description"
      content="CTO & Co-Founder at OpenLLM. Building decentralized systems, SDKs, and developer tools across Ethereum, Base, and beyond."
    />
    <meta property="og:image" content={portraitUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://0xmemo.com/" />
    <meta name="twitter:site" content="@0xxmemo" />
    <meta name="twitter:creator" content="@0xxmemo" />
    <meta name="twitter:title" content="0xMemo — Software Architect & Blockchain Builder" />
    <meta
      name="twitter:description"
      content="CTO & Co-Founder at OpenLLM. Building decentralized systems, SDKs, and developer tools across Ethereum, Base, and beyond."
    />
    <meta name="twitter:image" content={portraitUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
